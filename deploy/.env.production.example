# ============================================================
# /var/www/chatvan/.env.production
# このファイルを .env.production.example からコピーして
# 実際の値を埋めてください。Git には絶対コミットしないこと。
# ============================================================

# --- アプリ基本設定 ---
NODE_ENV=production
PORT=4820
APP_BASE_URL=https://chat-van.com

# --- ファイル保存（VPSローカル永続ディスク）---
# Replit Object Storage は本番で使用しません。
# このディレクトリはリポジトリ外のため、デプロイで消去されません。
LOCAL_UPLOAD_DIR=/var/lib/chatvan/uploads

# --- データベース（Neon PostgreSQL）---
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# --- セッション ---
SESSION_SECRET=（長いランダム文字列。openssl rand -hex 32 で生成）

# --- Square 決済 ---
SQUARE_ACCESS_TOKEN=（Square本番トークン）
SQUARE_ENV=production

# --- OpenAI（車検証OCR等）---
# VPSではReplit AI Integrationの環境変数ではなく、OpenAIのAPIキーを設定する。
OPENAI_API_KEY=（OpenAI APIキー）
OPENAI_BASE_URL=https://api.openai.com/v1

# --- メール（SMTP）---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chat VAN <noreply@chat-van.com>
ADMIN_NOTIFY_EMAIL=info@chat-van.com

# --- SEO / サイト ---
SITE_URL=https://chat-van.com
