modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SQUARE_APPLICATION_ID = "sq0idp-QftsA0A14JN6dHkikeGt3A"
SQUARE_ENVIRONMENT = "production"
SQUARE_LOCATION_ID = "LD95R63AEZZRH"
SMTP_HOST = "smtp.hostinger.com"
SMTP_PORT = "465"
SMTP_FROM = "Chat VAN <info@chat-van.com>"
CRITICAL_NOTIFICATION_EMAIL = "info@sinjapan.jp"
